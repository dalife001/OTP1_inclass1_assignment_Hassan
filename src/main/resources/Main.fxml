<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox fx:id="root" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.TemperatureController"
      spacing="12" alignment="TOP_LEFT"
      style="-fx-font-family: 'Noto Sans CJK JP';">
    <padding>
        <Insets top="24" right="24" bottom="24" left="24"/>
    </padding>
    <Label fx:id="titleLabel" text="%title" style="-fx-font-size: 22px; -fx-font-weight: bold;"/>
    <Label fx:id="languageLabel" text="%language"/>
    <ComboBox fx:id="languageComboBox" prefWidth="300"/>
    <Label fx:id="temperatureLabel" text="%temperature"/>
    <TextField fx:id="inputField" prefWidth="300"/>
    <Label fx:id="fromLabel" text="%from"/>
    <ComboBox fx:id="fromUnit" prefWidth="300"/>
    <Label fx:id="toLabel" text="%to"/>
    <ComboBox fx:id="toUnit" prefWidth="300"/>
    <Button fx:id="convertButton" text="%convert" onAction="#convert" prefWidth="300"/>
    <Label fx:id="resultLabel" wrapText="true"/>
    <Label text="%history"/>
    <ListView fx:id="historyList" prefHeight="110" prefWidth="300"/>
</VBox>
